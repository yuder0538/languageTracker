# 複製這份檔案為 .env 並依需要修改。.env 不會進版控（見 .gitignore）。

# SQLite 資料庫檔案路徑（相對於 backend/ 目錄）
DATABASE_URL=sqlite:///./data/immersion_tracker.db

# 英文字典：Free Dictionary API（免費、無需金鑰）
EN_DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# 德文字典：Phase 2 決定實際供應商（免費開放字典 API）後再填入 base URL
DE_DICTIONARY_API_BASE_URL=

# 預留給未來 LLM 翻譯/例句品質強化功能（目前不需要，留空即可）
LLM_API_KEY=
